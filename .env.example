# Supabase — copy this file to .env.local and fill in real values.
# The publishable (anon) key is safe to expose to the browser; row-level
# security on the database is what actually protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only secret key (NEVER prefix with NEXT_PUBLIC_, never commit).
# Needed later for privileged server actions / migrations.
# SUPABASE_SERVICE_ROLE_KEY=
